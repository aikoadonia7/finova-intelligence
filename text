# ---------------------------------------------------------------- data
def make_template() -> bytes:
    """Template Excel: sheet 'transaksi' dan sheet 'budget' (opsional)."""
    trx = pd.DataFrame({
        "date": ["2026-01-02", "2026-01-03", "2026-01-05", "2026-01-08"],
        "amount": [5000000, 750000, 1200000, 300000],
        "category": ["Penjualan", "Marketing", "Gaji", "Operasional"],
        "type": ["income", "expense", "expense", "expense"],
    })
    budget = pd.DataFrame({
        "category": ["Marketing", "Gaji", "Operasional"],
        "budget": [1000000, 1200000, 500000],
    })
    buf = io.BytesIO()
    with pd.ExcelWriter(buf, engine="openpyxl") as w:
        trx.to_excel(w, sheet_name="transaksi", index=False)
        budget.to_excel(w, sheet_name="budget", index=False)
    return buf.getvalue()


def read_any(file, sheet=None) -> pd.DataFrame:
    if file.name.lower().endswith(".csv"):
        return pd.read_csv(file)
    return pd.read_excel(file, sheet_name=sheet or 0)


@st.cache_data(show_spinner=False)
def load_data(file_bytes: bytes, name: str) -> tuple[pd.DataFrame, pd.DataFrame | None]:
    bio = io.BytesIO(file_bytes)
    bio.name = name
    if name.lower().endswith(".csv"):
        df, budget = pd.read_csv(bio), None
    else:
        xl = pd.ExcelFile(bio)
        df = xl.parse(xl.sheet_names[0])
        budget = xl.parse("budget") if "budget" in xl.sheet_names else None

    df.columns = [c.strip().lower() for c in df.columns]
    missing = {"date", "amount", "category"} - set(df.columns)
    if missing:
        raise ValueError(f"Kolom wajib tidak ditemukan: {', '.join(sorted(missing))}")

    df["date"] = pd.to_datetime(df["date"], errors="coerce")
    df["amount"] = pd.to_numeric(df["amount"], errors="coerce")
    df = df.dropna(subset=["date", "amount"]).copy()

    if "type" in df.columns:
        is_exp = df["type"].astype(str).str.lower().isin(["expense", "pengeluaran"])
        df["signed"] = np.where(is_exp, -df["amount"].abs(), df["amount"].abs())
    else:  # tanpa kolom type: positif = pemasukan, negatif = pengeluaran
        df["signed"] = df["amount"]

    if budget is not None:
        budget.columns = [c.strip().lower() for c in budget.columns]
        if not {"category", "budget"} <= set(budget.columns):
            budget = None
    return df, budget


def daily_series(df: pd.DataFrame) -> pd.Series:
    s = df.groupby(df["date"].dt.normalize())["signed"].sum()
    return s.reindex(pd.date_range(s.index.min(), s.index.max()), fill_value=0)


# ---------------------------------------------------------- analytics
def zscore_anomalies(daily: pd.Series, thr: float) -> pd.DataFrame:
    std = daily.std()
    if std == 0 or np.isnan(std):
        return pd.DataFrame(columns=["date", "net", "zscore"])
    z = (daily - daily.mean()) / std
    out = pd.DataFrame({"date": daily.index, "net": daily.values, "zscore": z.values})
    return out[out["zscore"].abs() > thr].reset_index(drop=True)


def iforest_anomalies(df: pd.DataFrame, contamination: float) -> pd.DataFrame:
    if len(df) < 10:
        return df.iloc[0:0]
    model = IsolationForest(contamination=contamination, random_state=42)
    flag = model.fit_predict(df[["signed"]])
    return df[flag == -1].sort_values("signed")


def forecast(daily: pd.Series, horizon: int) -> pd.DataFrame:
    x = np.arange(len(daily)).reshape(-1, 1)
    lr = LinearRegression().fit(x, daily.values)
    fx = np.arange(len(daily), len(daily) + horizon).reshape(-1, 1)
    idx = pd.date_range(daily.index[-1] + pd.Timedelta(days=1), periods=horizon)
    return pd.DataFrame({"forecast_net": lr.predict(fx)}, index=idx)


def variance_table(df: pd.DataFrame, budget: pd.DataFrame | None) -> pd.DataFrame | None:
    if budget is None:
        return None
    actual = (-df[df["signed"] < 0].groupby("category")["signed"].sum()).rename("actual")
    t = budget.set_index("category").join(actual, how="outer").fillna(0)
    t["variance"] = t["actual"] - t["budget"]
    t["variance_pct"] = np.where(t["budget"] != 0, t["variance"] / t["budget"] * 100, np.nan)
    return t.reset_index().sort_values("variance_pct", ascending=False)


def build_context(df, daily, income, expense, z_df, if_df, var_df, fc) -> str:
    cat = df.groupby("category")["signed"].sum().sort_values().round(0).to_dict()
    parts = [
        f"Periode: {daily.index.min().date()} s/d {daily.index.max().date()} ({len(daily)} hari)",
        f"Total pemasukan: {income:,.0f} | Total pengeluaran: {expense:,.0f} | Net: {income - expense:,.0f}",
        f"Net per kategori: {cat}",
        f"Anomali Z-Score (hari): {z_df.head(5).to_dict('records')}",
        f"Anomali Isolation Forest (transaksi): {if_df.head(5)[['date', 'category', 'signed']].astype(str).to_dict('records')}",
        f"Rata-rata forecast net harian: {fc['forecast_net'].mean():,.0f}",
    ]
    if var_df is not None:
        parts.append(f"Variance vs budget: {var_df.round(1).to_dict('records')}")
    return "\n".join(parts)


# ------------------------------------------------------------------ AI
def get_client() -> Groq | None:
    try:
        key = st.secrets["GROQ_API_KEY"]
    except Exception:  # secrets belum diatur sama sekali
        return None
    return Groq(api_key=key) if key else None


def ask_llm(client: Groq, messages: list[dict]) -> str:
    resp = client.chat.completions.create(model=GROQ_MODEL, messages=messages, temperature=0.3)
    return resp.choices[0].message.content


def system_prompt(context: str) -> str:
    return (
        "Anda adalah analis keuangan (FP&A) yang menjawab dalam Bahasa Indonesia, ringkas, "
        "berbasis angka. Jangan mengarang data di luar konteks berikut.\n\n" + context
    )


# -------------------------------------------------------------- export
def export_excel(summary, daily, z_df, if_df, var_df, commentary) -> bytes:
    buf = io.BytesIO()
    with pd.ExcelWriter(buf, engine="openpyxl") as w:
        pd.DataFrame(summary.items(), columns=["metrik", "nilai"]).to_excel(w, sheet_name="ringkasan", index=False)
        daily.rename("net").reset_index(names="date").to_excel(w, sheet_name="harian", index=False)
        z_df.to_excel(w, sheet_name="anomali_zscore", index=False)
        if_df.to_excel(w, sheet_name="anomali_iforest", index=False)
        if var_df is not None:
            var_df.to_excel(w, sheet_name="variance", index=False)
        pd.DataFrame({"AI Commentary": [commentary or "-"]}).to_excel(w, sheet_name="ai_commentary", index=False)
    return buf.getvalue()


def export_word(summary, z_df, var_df, commentary) -> bytes:
    doc = Document()
    doc.add_heading("Laporan FinSmart Analytics", 0)
    doc.add_heading("Ringkasan", 1)
    for k, v in summary.items():
        doc.add_paragraph(f"{k}: {v}", style="List Bullet")
    doc.add_heading("Anomali Harian (Z-Score)", 1)
    doc.add_paragraph(z_df.head(10).to_string(index=False) if len(z_df) else "Tidak ada anomali.")
    if var_df is not None:
        doc.add_heading("Variance vs Budget", 1)
        doc.add_paragraph(var_df.round(1).to_string(index=False))
    doc.add_heading("Komentar AI", 1)
    doc.add_paragraph(commentary or "Belum ada komentar AI.")
    buf = io.BytesIO()
    doc.save(buf)
    return buf.getvalue()


